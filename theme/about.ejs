<%- include('_includes/header', { siteConfig }); -%>

<div class="about__content pad-0">
    <h1><%- siteConfig.owner?.name || siteConfig.title %></h1>
    <div class="about__description">
        <%- html %>
    </div>
</div>

<%
  const social = siteConfig.social || {};
  const links = [];
  if (social.github) links.push({ label: 'GitHub', href: `https://github.com/${social.github}`, meta: social.github, className: 'link-github' });
  if (social.medium) links.push({ label: 'Medium', href: `https://medium.com/@${social.medium}`, meta: social.medium, className: 'link-medium' });
  if (social.twitter) links.push({ label: 'Twitter', href: `https://twitter.com/${social.twitter}`, meta: social.twitter, className: 'link-twitter' });
  if (siteConfig.owner?.email) links.push({ label: 'Email', href: `mailto:${siteConfig.owner.email}`, meta: siteConfig.owner.email, className: 'link-email' });
%>

<% if (links.length) { %>
<section id="contact" class="mar-b-7">
    <h3 class="section__title">Elsewhere</h3>
    <div class="post-list">
        <% for (const link of links) { %>
        <a target="_blank" rel="noopener" class="post <%- link.className %>" href="<%- link.href %>">
            <span class="post__title"><%- link.label %></span>
            <span class="post__date"><%- link.meta %></span>
        </a>
        <% } %>
    </div>
</section>
<% } %>

<%- include('_includes/footer', { siteConfig }) %>
